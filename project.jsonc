{
  "$schema": "https://jadmadi.net/schemas/project.schema.json",
  // Timestamp of the last metadata revision (Format: YY-MM-DD-HH-MM)
  "lastEdit": "26-11-07-10-47",

  // Unique identifier matching the project URL slug on jadmadi.net
  "id": "agentmeter",

  // Human-readable title
  "title": "AgentMeter",

  // Single-sentence punchy tagline
  "tagline": "Local-first analytics and cross-tool comparison for AI coding agents",

  // Semantic version (SemVer, e.g. "0.18.0", or CalVer, e.g. "2026.9.0")
  "version": "2.1.0",

  // 2-3 sentence executive summary explaining what it does, why it exists, and zero-bullshit proof
  "summary": "AgentMeter reads the session stores that Command Code, OpenCode, Muse, and DeepSeek Harness (dsh) already write on disk, reconstructs per-step throughput, tokens, cache, cost, tool time, and session health, and renders filterable HTML and terminal reports. It compares any two tools with shared model-family pooling and explicit caveats. It is a single Go binary, read-only, offline, and sends nothing anywhere.",

  // Status on catalog: "featured" | "active" | "in-progress" | "upstream-merged" | "beta" | "archived"
  "status": "active",

  // Release or active year
  "year": "2026",

  // Technical stack breakdown
  "tech_stack": {
    "languages": ["Go", "SQLite", "Python"],
    "frameworks": [
      "Go standard library",
      "modernc.org/sqlite",
      "Embedded HTML/CSS/JavaScript"
    ],
    "architecture": "Single static Go binary with read-only SQLite and JSONL readers, schema v3 fail-closed report and comparison builders, embedded HTML dashboards, and six cross-platform release archives",
    "license": "AGPL-3.0-only",
    "license_type": "copyleft" // "permissive" | "copyleft" | "waqf" | "proprietary"
  },

  // One-line metrics/capabilities pill shown on cards and tables
  "stats": "4 Tools · Cross-Tool Compare · Schema v3 · AGPL-3.0",

  // Highlight badges displayed on project cards
  "badges": [
    "Go CLI",
    "Local-First",
    "Zero Telemetry",
    "Schema v3",
    "AGPL-3.0"
  ],

  // Primary 1-line installation snippet (shown in copyable terminal widget)
  "install_command": "go install github.com/jadmadi/agentmeter/cmd/agentmeter@latest",

  // Multi-platform install commands (optional)
  "install_commands": {
    "linux_macos": "go install github.com/jadmadi/agentmeter/cmd/agentmeter@latest",
    "windows": "go install github.com/jadmadi/agentmeter/cmd/agentmeter@latest",
    "go": "go install github.com/jadmadi/agentmeter/cmd/agentmeter@latest"
  },

  // Authoritative external links
  "links": {
    "github": "https://github.com/jadmadi/agentmeter",
    "website": "https://jadmadi.net/project/agentmeter",
    "docs": "https://github.com/jadmadi/agentmeter/blob/main/README.md",
    "package": "https://pkg.go.dev/github.com/jadmadi/agentmeter"
  },

  // Problem statement: What pain point does this solve?
  "problem_statement": "Developers running more than one AI coding agent cannot see how token spend, cache efficiency, latency, and session health compare across tools. The evidence sits in different local stores, in different shapes, and usually only surfaces one vendor at a time.",

  // Solution: How does this solve it?
  "solution": "AgentMeter reads those local stores read-only, validates one schema v3 across tools, and renders per-tool reports plus like-for-like comparisons in a single static binary. It names the winner, shows the uncertainty, and marks cost and coverage caveats instead of hiding them.",

  // List of major capabilities and distinct features
  "features": [
    "Per-tool reports for Command Code, OpenCode, Muse, and DeepSeek Harness (dsh) covering throughput, tokens, cache, reasoning, cost, tool time, and session health",
    "Cross-tool comparison for any pair (oc-cmd, oc-muse, oc-dsh, cmd-muse, cmd-dsh, muse-dsh) with shared model-family pooling, output-size strata, explicit verdict confidence, and Simpson's-paradox detection",
    "Schema v3 fail-closed report and comparison builders plus independent Python oracle audits and fixture parity checks",
    "Read-only local readers: OpenCode SQLite, Command Code, Muse, and DSH (.jsonl.zstd / .jsonl) session logs; no prompts, assistant text, tool arguments, or file contents are read or emitted",
    "Embedded HTML dashboards and JSON/JS data files, with --serve and --watch, plus --json modes for cmd, oc, muse, dsh, and compare",
    "Per-tool wall-clock split into work and wait time, and per-model timed coverage that gates fixed-latency rankings",
    "Cost labels that mark recorded spend as a provider-reported floor and cache savings as a counterfactual, not a bill reduction",
    "Strict CLI behavior: date-window validation, fail-closed empty sources, actionable wrong-side report errors, ANSI-aware width adaptation, and documented exit codes 0/1/2",
    "Six cross-platform release archives for Linux, macOS, and Windows with checksums and AGPL, NOTICE, and third-party license texts"
  ],

  // Frequently Asked Questions (displayed on project subpage & Schema.org FAQPage)
  "faq": [
    {
      "question": "Does AgentMeter send my session data to the cloud?",
      "answer": "No. AgentMeter is local-first and zero-telemetry. It reads the local stores already on your disk, opens the OpenCode database read-only, and makes no network requests."
    },
    {
      "question": "Which tools can I analyze and compare?",
      "answer": "Command Code, OpenCode, Muse, and DeepSeek Harness (dsh). Any two can be compared (`agentmeter compare`), and each tool also has its own report command (`agentmeter cmd`, `agentmeter oc`, `agentmeter muse`, `agentmeter dsh`)."
    },
    {
      "question": "How do I install AgentMeter?",
      "answer": "Use a precompiled release archive from GitHub, or run `go install github.com/jadmadi/agentmeter/cmd/agentmeter@latest` with Go 1.26 or newer. `./build.sh --all` builds the same six archives locally."
    },
    {
      "question": "Why is recorded cost called a floor?",
      "answer": "Recorded cost comes from what the provider reports. Free, contributor, and subscription-tier models may report $0, so per-step and per-1M figures can understate paid usage. Cache savings are a counterfactual at fitted prices, not money removed from a bill."
    },
    {
      "question": "Does AgentMeter read my prompts or code?",
      "answer": "No. It reads usage, timing, model, and tool metadata. It does not read or emit prompts, assistant text, tool arguments, or file contents. Session titles and project names are included by default and can be suppressed with `--no-titles` and `--full-paths`."
    }
  ]
}
